#!/usr/bin/env bash

LIB_DIR="$(dirname "$0")/lib/vibecheck"
METRIC_COLUMN_COUNT=3
METRIC_DETAIL_COLUMN=3
FORMAT_METRICS=(
    "$LIB_DIR/format-columns.sh"
    --columns "$METRIC_COLUMN_COUNT"
    --dim "$METRIC_DETAIL_COLUMN"
)

case "${1:-}" in
    help|-h|--help)
        "$LIB_DIR/show-help.sh"
        ;;
    tray)
        "$LIB_DIR/list-tray-apps.sh"
        ;;
    ports|--ports)
        shift
        "$LIB_DIR/list-ports.sh" "$@"
        ;;
    port|--port)
        shift
        "$LIB_DIR/get-port-process.sh" "$@"
        ;;
    :*)
        port="${1#:}"
        "$LIB_DIR/get-port-process.sh" "$port"
        ;;
    cpu)
        "$LIB_DIR/get-system-metrics.sh" "$@"
        ;;
    ram|gpu|igpu|dgpu|fan|fans|bat|disk|storage)
        "$LIB_DIR/get-system-metrics.sh" "$@"
        ;;
    ip)
        mapfile -t iface_ips < <(ip -4 addr show scope global | awk '
            /^[0-9]+:/ { iface = $2; gsub(/:/, "", iface) }
            /inet /    { ip = $2; gsub(/\/.*/, "", ip); if (ip != "") print iface " " ip }
        ')
        public_ip=$(curl -sf --max-time 3 https://ifconfig.me 2>/dev/null || echo "n/a")
        maxlen=6  # length of "Public"
        for entry in "${iface_ips[@]}"; do
            iface="${entry%% *}"
            (( ${#iface} > maxlen )) && maxlen=${#iface}
        done
        for entry in "${iface_ips[@]}"; do
            printf "%-*s %s\n" "$maxlen" "${entry%% *}" "${entry##* }"
        done
        printf "%-*s %s\n" "$maxlen" "Public" "$public_ip"
        ;;
    net|internet)
        "$LIB_DIR/get-net-info.sh"
        ;;
    hw|hardware)
        shift
        "$LIB_DIR/get-hardware-info.sh" "$@"
        ;;
    "")
        "$LIB_DIR/get-system-metrics.sh" | "${FORMAT_METRICS[@]}"
        ;;
    -*)
        printf "vch: unknown option '%s'\n" "$1" >&2
        printf "Try 'vch --help' for usage.\n" >&2
        exit 2
        ;;
    *)
        if [[ "$1" =~ ^[0-9]+$ ]]; then
            output=$("$LIB_DIR/get-port-process.sh" "$1" 2>/dev/null)
            if [[ "$output" == "Literally nothing on :"* ]]; then
                if ! "$LIB_DIR/find-process.sh" -p "$1" 2>/dev/null; then
                    echo "I didn't find anything"
                fi
            else
                echo "$output"
            fi
        else
            output=$("$LIB_DIR/find-process.sh" "$1" 2>/dev/null)
            if [[ -n "$output" ]]; then
                echo "$output"
            else
                echo "I didn't find anything"
            fi
        fi
        ;;
esac
