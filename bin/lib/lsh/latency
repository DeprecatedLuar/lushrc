#!/usr/bin/env bash
# Print a compact latency suffix for an lsh tmux window. tmux runs this via
# #() without blocking status rendering and owns the command lifecycle.

window_id=${1:-}
[[ $window_id =~ ^@[0-9]+$ ]] || exit 0

host=$(tmux show-options -w -v -t "$window_id" @lsh_host 2>/dev/null) || exit 0
[[ -n $host ]] || exit 0

sample=$(LC_ALL=C ping -n -c 1 -W 1 -- "$host" 2>/dev/null) || exit 0
latency=$(sed -nE \
    's/.*time[=<]([0-9]+([.][0-9]+)?)[[:space:]]*ms.*/\1/p' \
    <<< "$sample" | head -n 1)
[[ -n $latency ]] || exit 0

awk -v latency="$latency" 'BEGIN { printf "%.0fms\n", latency }'
