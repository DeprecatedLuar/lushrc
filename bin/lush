#!/usr/bin/env bash
# lush - lushrc management utility

set -euo pipefail

BASHRC="${BASHRC:-$HOME/.config/lushrc}"
SYSDIR="${SYSDIR:-$BASHRC/system}"
SYS_BIN="$HOME/bin/sys"

# --- Tool lifecycle helpers (bin/lib/<tool>/main.sh) ---

lush_available_tools() {
    git -C "$BASHRC" ls-tree -r --name-only HEAD -- bin/lib 2>/dev/null \
        | grep '/main\.sh$' \
        | while IFS= read -r path; do
              rel="${path#bin/lib/}"
              echo "${rel%%/*}"
          done | sort -u
}

lush_install_one() {
    local tool="$1"

    if [[ -f "$BASHRC/bin/lib/$tool/main.sh" ]]; then
        echo "$tool: already installed"
        return 0
    fi

    if ! git -C "$BASHRC" ls-tree -r --name-only HEAD -- "bin/lib/$tool/main.sh" | grep -q .; then
        echo "$tool: unknown tool" >&2
        return 1
    fi

    git -C "$BASHRC" checkout HEAD -- "bin/lib/$tool" || { echo "$tool: install failed" >&2; return 1; }
    echo "$tool: installed"
}

lush_rm_one() {
    local tool="$1" force="$2"
    local dir="$BASHRC/bin/lib/$tool"

    [[ -d "$dir" ]] || { echo "$tool: not installed"; return 0; }

    if [[ "$force" != true ]]; then
        local dirty
        dirty="$(git -C "$BASHRC" status --porcelain -- "$dir" 2>/dev/null)"
        if [[ -n "$dirty" ]]; then
            echo "$tool: uncommitted changes in bin/lib/$tool — refusing (use --force)" >&2
            return 1
        fi
    fi

    rm -rf "$dir"
    echo "$tool: removed"
}

case "${1:-help}" in
    root)
        [[ -z "$2" ]] && { echo "Usage: lush root <program> [program2...]"; exit 1; }
        shift
        for prog in "$@"; do
            bin=$(command -v "$prog" 2>/dev/null)
            if [[ -z "$bin" ]]; then
                echo "$prog: not found"
                continue
            fi
            mkdir -p "$SYS_BIN"
            ln -sf "$bin" "$SYS_BIN/$prog"
            echo "$prog -> $SYS_BIN/"
        done
        "$SYSDIR/reload/reload.sh" -s
        ;;

    update)
        cd "$BASHRC" || exit 1

        # Check for local changes
        if ! git diff --quiet HEAD 2>/dev/null; then
            echo "Local changes detected:"
            git status --short
            echo
            read -rp "Discard changes and update? [y/N] " answer
            [[ "$answer" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 1; }
            git reset --hard HEAD
        fi

        git pull
        "$SYSDIR/reload/reload.sh"
        ;;

    status)
        cd "$BASHRC" || exit 1
        git status --short
        ;;

    version)
        cd "$BASHRC" || exit 1
        echo "lushrc @ $(git rev-parse --short HEAD) ($(git log -1 --format='%cr'))"
        ;;

    install)
        shift
        [[ $# -eq 0 ]] && { echo "Usage: lush install <tool>|-A|--all"; exit 1; }

        status=0
        if [[ "$1" == "-A" || "$1" == "--all" ]]; then
            while IFS= read -r tool; do
                lush_install_one "$tool" || status=1
            done < <(lush_available_tools)
        else
            for tool in "$@"; do
                lush_install_one "$tool" || status=1
            done
        fi
        exit "$status"
        ;;

    rm|remove|uninstall)
        shift
        force=false
        tools=()
        for arg in "$@"; do
            case "$arg" in
                --force) force=true ;;
                *) tools+=("$arg") ;;
            esac
        done
        [[ ${#tools[@]} -eq 0 ]] && { echo "Usage: lush rm <tool> [--force]"; exit 1; }

        status=0
        for tool in "${tools[@]}"; do
            lush_rm_one "$tool" "$force" || status=1
        done
        exit "$status"
        ;;

    list)
        printf "%-20s %s\n" "TOOL" "STATUS"
        while IFS= read -r tool; do
            if [[ -f "$BASHRC/bin/lib/$tool/main.sh" ]]; then
                printf "%-20s %s\n" "$tool" "installed"
            else
                printf "%-20s %s\n" "$tool" "available"
            fi
        done < <(lush_available_tools)
        ;;

    help|*)
        cat << 'EOF'
lush - lushrc management

Commands:
  root <prog>          - Symlink to ~/bin/sys for sudo access
  update               - Pull latest from remote
  status               - Show local changes
  version              - Show current version
  install <tool>|-A    - Install a lazily-shipped tool (-A/--all for every one)
  rm <tool> [--force]  - Remove an installed tool's implementation
  list                 - List available/installed tools
  help                 - Show this message
EOF
        ;;
esac
